{
	"name": "DerethTheme",
	"version": "1.0.0",
	"author": "wiki.dereth.network",
	"description": "The dereth.network look for the Citizen skin, and fixes that make the ACCPP Wiki's templates work with it: dark-mode colours, wide-table scrolling, stacked infoboxes on phones, and the footer text.",
	"license-name": "Unlicense",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.43.0"
	},
	"AutoloadClasses": {
		"DerethThemeHooks": "includes/Hooks.php"
	},
	"Hooks": {
		"BeforePageDisplay": "DerethThemeHooks::onBeforePageDisplay",
		"MessagesPreLoad": "DerethThemeHooks::onMessagesPreLoad"
	},
	"ResourceFileModulePaths": {
		"localBasePath": "resources",
		"remoteExtPath": "DerethTheme/resources"
	},
	"ResourceModules": {
		"ext.derethTheme.styles": {
			"styles": [ "dereth.css", "theme.css", "dark.css" ]
		},
		"ext.derethTheme": {
			"packageFiles": [ "theme.js" ]
		}
	},
	"manifest_version": 2
}
