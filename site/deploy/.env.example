# Copy to .env (or run ./gen-env.sh, which fills in the secrets for you).

# Where data/ lives on this machine: images/ and mediawiki-1.43.sql.gz.
DATA_DIR=/srv/wiki/data

WIKI_SERVER=https://wiki.dereth.network

# openssl rand -hex 32 each. They only need to match between services;
# nothing outside this file knows them.
DB_ROOT_PASSWORD=
DB_RW_PASSWORD=
DB_RO_PASSWORD=
MW_SECRET_KEY=

# Only for `--profile tunnel`, i.e. when this box does NOT already run a
# Cloudflare Tunnel. If it does, leave this empty and add wiki.dereth.network
# to that tunnel instead (see README, step 2).
CLOUDFLARE_TUNNEL_TOKEN=
